{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Build Extension (ZIP)",
      "type": "shell",
      "command": "mkdir -p dist && zip -r dist/ai_roto_bridge-0.1.0.zip . -x '*.git*' '*__pycache__*' '*.vscode*' 'dist/*' 'docs/*'",
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": false,
        "panel": "shared",
        "showReuseMessage": false
      },
      "problemMatcher": []
    }
  ]
}